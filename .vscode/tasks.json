{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PlatformIO Token-Optimized Build",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				".\\tools\\safe_build.ps1"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"type": "PlatformIO",
			"task": "Build",
			"problemMatcher": [
				"$platformio"
			],
			"group": "build",
			"label": "PlatformIO: Build"
		}
	]
}